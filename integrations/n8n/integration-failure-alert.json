{
  "name": "QMD - Integration Failure Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "qmd-failure-alert",
        "responseMode": "onReceived"
      },
      "name": "Webhook Failure Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $env.ADMIN_WHATSAPP_NUMBER }}\",\n  \"text\": \"⚠️ *ALERTA DE FALHA DE INTEGRAÇÃO QMD*\\nEvento: {{ $json.body.eventType }}\\nErro: {{ $json.body.lastError }}\\nID do Evento: {{ $json.body.eventId }}\"\n}"
      },
      "name": "Send Alert to Admin WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    }
  ]
}
