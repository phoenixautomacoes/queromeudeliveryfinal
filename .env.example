# Quero Meu Delivery V2 - Variáveis de Ambiente

# Ambiente e Execução
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Banco de Dados (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/queromeudelivery

# Segurança e Sessão
SESSION_SECRET=change-this-to-a-secure-random-64-character-secret-in-production
PASSWORD_PEPPER=optional-pepper-string-for-bcrypt

# Servidor SMTP para Emails Transacionais e Recuperação de Senha
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Quero Meu Delivery <nao-responda@queromeudelivery.com.br>"

# Supabase Storage para Upload de Imagens de Produtos e Logos
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=store-assets

# Webhooks n8n (WhatsApp Notifications)
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/qmd-events
N8N_WEBHOOK_SECRET=your-hmac-webhook-secret-key

# Evolution API (WhatsApp Direct Gateway)
EVOLUTION_API_URL=https://whatsapp.yourdomain.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=qmd-instance

# Gateway de Pagamento Online (Mercado Pago Adapter)
MERCADO_PAGO_ACCESS_TOKEN=TEST-your-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-mp-webhook-secret

# Google Maps API (Opcional - Browser Key com restrição de domínio)
GOOGLE_MAPS_BROWSER_KEY=

# Nível de Logs (debug, info, warn, error)
LOG_LEVEL=info

